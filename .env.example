# Momentum — environment variables (TEMPLATE)
# Copy this file to `.env` and fill in the real values from your Supabase project.
# `.env` is gitignored; this `.env.example` is safe to commit (no real values).

# --- Supabase ---
# Settings > API (or "API Keys") in your Supabase dashboard.

# Project URL and the anon/publishable key are safe for the browser.
# The NEXT_PUBLIC_ prefix means Next.js exposes them to the client on purpose —
# that's fine, because Row-Level Security is what actually protects your data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role (a.k.a. "secret") key bypasses Row-Level Security.
# It is SERVER-ONLY. It must never have the NEXT_PUBLIC_ prefix and must never
# reach the browser. Not needed yet for MVP — fill in only when server code needs it.
SUPABASE_SERVICE_ROLE_KEY=
